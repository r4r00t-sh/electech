# Public site URL (used for sitemap, canonical, OG, share links).
# Keep this on the Vercel deployment host until the real domain is configured.
NEXT_PUBLIC_SITE_URL=https://electech-black.vercel.app

# Google Analytics 4 measurement ID (loaded only after cookie consent)
NEXT_PUBLIC_GA_ID=

# Form delivery (Resend). FORM_TO_EMAIL is preferred; CONTACT_TO_EMAIL kept as fallback.
RESEND_API_KEY=
FORM_TO_EMAIL=info@electechmep.com
FORM_CC_EMAIL=projects@electechmep.com
CONTACT_TO_EMAIL=info@electechmep.com
CONTACT_FROM_EMAIL=website@electechmep.com

# Preview: show unapproved client logos (defaults on in non-production)
# SHOW_UNAPPROVED_LOGOS=true
